# ====================================================================
# Dangly .gitignore - Cross-platform (.NET 10 / WPF & macOS / Xcode)
# ====================================================================

# OS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
desktop.ini

# .NET / Visual Studio / MSBuild
**/[Bb]in/
**/[Oo]bj/
.vs/
.dotnet/
.dotnet_tmp/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
TestResults/
[Pp]ublish/

# Visual Studio Code & JetBrains IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.DotSettings.user

# Xcode & Apple Platforms
build/
dist/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.xcscmblueprint
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Xcode Project User Overrides
**/*.xcodeproj/project.xcworkspace/xcuserdata/
**/*.xcodeproj/project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
**/*.xcodeproj/xcuserdata/

# Swift Package Manager
.build/
.swiftpm/
Packages/

# Profiling, Logs & Diagnostics
*.profraw
*.profdata
*.log
*.crash
crashlytics-build.properties
