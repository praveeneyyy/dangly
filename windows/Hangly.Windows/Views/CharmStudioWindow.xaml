<Window x:Class="Hangly.Windows.Views.CharmStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:Hangly.Windows.Rendering"
        Title="Dangly — Charm Studio &amp; Customizer"
        Width="1120" Height="740"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#09090B"
        Foreground="#F4F4F5"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif">
    
    <Window.Resources>
        <!-- Modern Obsidian Palette -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#121215" />
        <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#1F1F26" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#18181C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#9061F9" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F5" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#71717A" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="#202026" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2D2D36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A33" />
                                <Setter Property="BorderBrush" Value="#3D3D49" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#7C3AED" />
            <Setter Property="BorderBrush" Value="#8B5CF6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6D28D9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="#1A1A20" />
            <Setter Property="BorderBrush" Value="#282832" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#141418" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="BorderBrush" Value="#2A2A33" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="#A855F7" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#141418" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="BorderBrush" Value="#2A2A33" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#7C3AED" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Setting Card -->
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid AllowDrop="True" DragEnter="OnDropZoneDragEnter" DragLeave="OnDropZoneDragLeave" Drop="OnDropZoneDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Branding & Charm Picker -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✦ " FontSize="16" Foreground="#A855F7" VerticalAlignment="Center" />
                    <TextBlock Text="Charm Studio" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />

                    <TextBlock Text="Active Charm:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="CharmSelectorComboBox" Width="180" SelectionChanged="OnCharmSelectedChanged" Margin="0,0,10,0" />
                </StackPanel>

                <!-- Right Action Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DesktopModeButton" Content="🖥 Desktop Mode: Off" Click="OnToggleDesktopModeClicked" Margin="0,0,8,0" ToolTip="Toggle miniature desktop screen mockup" />
                    <Button x:Name="OpenImageButton" Content="Open Image…" Click="OnOpenImageClicked" Margin="0,0,8,0" ToolTip="Import custom PNG, JPEG, WebP, or SVG" />
                    <CheckBox x:Name="UseOnRopeCheckBox" Content="Use on desktop" IsChecked="True" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="SaveToLibraryButton" Content="💾 Save Customization" Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN THREE-COLUMN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- LEFT COLUMN: PRESETS, RESET, BACKGROUND & SOURCE -->
            <!-- ============================================== -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,1,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- PRESETS CARD -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="PRESETS" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                                <WrapPanel Margin="0,0,0,4">
                                    <Button Content="Default" Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,6" Click="OnPresetDefaultClicked" />
                                    <Button Content="Minimal" Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,6" Click="OnPresetMinimalClicked" />
                                    <Button Content="Neon" Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,6" Click="OnPresetNeonClicked" />
                                    <Button Content="Ocean" Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,6" Click="OnPresetOceanClicked" />
                                    <Button Content="Sunset" Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,6" Click="OnPresetSunsetClicked" />
                                    <Button Content="Monochrome" Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,6" Click="OnPresetMonochromeClicked" />
                                    <Button Content="Candy" Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,6" Click="OnPresetCandyClicked" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- RESET CARD -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="RESET CONTROLS" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Reset Charm" Click="OnResetCharmClicked" Margin="0,0,4,4" Style="{StaticResource ChipButtonStyle}" />
                                    <Button Grid.Column="1" Content="Reset Rope" Click="OnResetRopeClicked" Margin="4,0,0,4" Style="{StaticResource ChipButtonStyle}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Reset Effects" Click="OnResetAppearanceClicked" Margin="0,0,4,0" Style="{StaticResource ChipButtonStyle}" />
                                    <Button Grid.Column="1" Content="Reset All" Click="OnResetAllClicked" Margin="4,0,0,0" Style="{StaticResource ChipButtonStyle}" Foreground="#F87171" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- BACKGROUND CUSTOMIZATION CARD -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="STAGE BACKGROUND" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />

                                <TextBlock Text="Solid Swatches" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <WrapPanel Margin="0,0,0,10">
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#09090B" BorderBrush="#2D2D38" BorderThickness="1" Margin="0,0,6,4" Cursor="Hand" MouseDown="OnBgColorSwatchClicked" Tag="#09090B" ToolTip="Obsidian" />
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#16161A" BorderBrush="#2D2D38" BorderThickness="1" Margin="0,0,6,4" Cursor="Hand" MouseDown="OnBgColorSwatchClicked" Tag="#16161A" ToolTip="Dark Slate" />
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#0D1520" BorderBrush="#2D2D38" BorderThickness="1" Margin="0,0,6,4" Cursor="Hand" MouseDown="OnBgColorSwatchClicked" Tag="#0D1520" ToolTip="Midnight Navy" />
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#1F1123" BorderBrush="#2D2D38" BorderThickness="1" Margin="0,0,6,4" Cursor="Hand" MouseDown="OnBgColorSwatchClicked" Tag="#1F1123" ToolTip="Dark Plum" />
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#0C1D16" BorderBrush="#2D2D38" BorderThickness="1" Margin="0,0,6,4" Cursor="Hand" MouseDown="OnBgColorSwatchClicked" Tag="#0C1D16" ToolTip="Deep Forest" />
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#000000" BorderBrush="#2D2D38" BorderThickness="1" Margin="0,0,6,4" Cursor="Hand" MouseDown="OnBgColorSwatchClicked" Tag="#000000" ToolTip="Pure Black" />
                                </WrapPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BgColorTextBox" Text="#16161A" FontSize="11" TextChanged="OnBgColorTextChanged" Margin="0,0,6,0" />
                                    <Button Grid.Column="1" Content="Apply" Click="OnApplyBgColorClicked" Padding="8,4" />
                                </Grid>

                                <CheckBox x:Name="BgGradientCheckBox" Content="Enable Linear Gradient" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Checked="OnBgGradientToggled" Unchecked="OnBgGradientToggled" Margin="0,0,0,8" />

                                <StackPanel x:Name="GradientControlsPanel" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Start Hex" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                                            <TextBox x:Name="GradientStartTextBox" Text="#1F1F26" TextChanged="OnGradientChanged" FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="End Hex" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                                            <TextBox x:Name="GradientEndTextBox" Text="#0E0E11" TextChanged="OnGradientChanged" FontSize="11" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Gradient Angle (0° - 360°)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="GradientAngleSlider" Minimum="0" Maximum="360" Value="45" ValueChanged="OnGradientSliderChanged" />
                                        <TextBlock Grid.Column="1" Text="{Binding ElementName=GradientAngleSlider, Path=Value, StringFormat={}{0:F0}°}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="Stage Opacity (10% - 100%)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="BgOpacitySlider" Minimum="0.1" Maximum="1.0" Value="1.0" ValueChanged="OnBgOpacityChanged" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=BgOpacitySlider, Path=Value, StringFormat={}{0:P0}}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- IMAGE BACKGROUND REMOVAL (Active only when custom file is loaded) -->
                        <Border x:Name="ImageIsolationCard" Style="{StaticResource SettingCard}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="IMAGE BACKGROUND REMOVAL" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />

                                <TextBlock Text="Strategy" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox x:Name="StrategyComboBox" SelectionChanged="OnStrategyChanged" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Automatic (Smart)" IsSelected="True" />
                                    <ComboBoxItem Content="Corner Flood Fill" />
                                    <ComboBoxItem Content="Keep Original (None)" />
                                </ComboBox>

                                <TextBlock Text="Tolerance (0 - 100)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="ToleranceSlider" Minimum="0" Maximum="100" Value="36" ValueChanged="OnToleranceChanged" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=ToleranceSlider, Path=Value, StringFormat={}{0:F0}}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                                </Grid>

                                <Button Content="Re-process Image" Click="OnReprocessClicked" Margin="0,0,0,12" />

                                <TextBlock Text="SOURCE THUMBNAIL" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                                <Border BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6" Background="#0E0E10" Height="100" Padding="4">
                                    <Image x:Name="SourceImagePreview" Stretch="Uniform" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============================================== -->
            <!-- MIDDLE COLUMN: INTERACTIVE LIVE PREVIEW STAGE -->
            <!-- ============================================== -->
            <Grid Grid.Column="1" Background="#0C0C0E">
                <!-- Preview Stage Container with dynamic background -->
                <Border x:Name="PreviewStageBorder" Background="#16161A" CornerRadius="12" Margin="16" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <!-- DESKTOP PREVIEW FRAME (Shown when Desktop Mode is ON) -->
                        <Grid x:Name="DesktopMockupFrame" Visibility="Collapsed">
                            <!-- Desktop Wallpaper representation -->
                            <Border Background="#182333" Opacity="0.95" />
                            
                            <!-- Miniature Monitor Bezel & Window Header -->
                            <Border BorderBrush="#2F3342" BorderThickness="2" CornerRadius="8" Margin="14">
                                <Grid>
                                    <!-- Mini Taskbar at bottom -->
                                    <Border Height="28" Background="#0F131C" VerticalAlignment="Bottom" Opacity="0.9" Padding="10,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="❖" FontSize="12" Foreground="#60A5FA" Margin="0,0,8,0" />
                                            <TextBlock Text="Dangly Desktop Preview" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Anchor Pin marker -->
                                    <Ellipse Width="10" Height="10" Fill="#A855F7" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" ToolTip="Cord Anchor" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Live Interactive Rope & Charm Canvas -->
                        <rendering:RopeCanvas x:Name="StudioCanvas" 
                                              HorizontalAlignment="Stretch" 
                                              VerticalAlignment="Stretch"
                                              MouseDown="OnCanvasMouseDown"
                                              MouseMove="OnCanvasMouseMove"
                                              MouseUp="OnCanvasMouseUp"
                                              MouseLeave="OnCanvasMouseLeave"
                                              Cursor="Hand" />

                        <!-- Top-Left Canvas Indicator -->
                        <Border Background="#CC0F0F12" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Padding="8,4" BorderBrush="#262630" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="● " FontSize="10" Foreground="#10B981" VerticalAlignment="Center" />
                                <TextBlock Text="Live 240Hz Physics — Drag/Swing" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Top-Right Preset Indicator -->
                        <Border Background="#CC0F0F12" CornerRadius="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" Padding="8,4" BorderBrush="#262630" BorderThickness="1">
                            <TextBlock x:Name="ActivePresetBadgeText" Text="Preset: Default" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- RIGHT COLUMN: REAL-TIME CUSTOMIZATION CONTROLS -->
            <!-- ============================================== -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1,0,0,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 1. CHARM & TRANSFORMS CARD -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="CHARM SIZE &amp; TRANSFORMS" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />

                                <TextBlock Text="Charm Size (0.5x - 2.5x)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="45" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="CharmSizeSlider" Minimum="0.5" Maximum="2.5" Value="1.0" ValueChanged="OnCharmSizeChanged" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=CharmSizeSlider, Path=Value, StringFormat={}{0:F2}x}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Size Preset Buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Small (0.75x)" Style="{StaticResource ChipButtonStyle}" Margin="0,0,4,0" Click="OnSizeSmallClicked" />
                                    <Button Content="Medium (1.0x)" Style="{StaticResource ChipButtonStyle}" Margin="0,0,4,0" Click="OnSizeMediumClicked" />
                                    <Button Content="Large (1.4x)" Style="{StaticResource ChipButtonStyle}" Click="OnSizeLargeClicked" />
                                </StackPanel>

                                <TextBlock Text="Rotation Angle (-180° to +180°)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="RotationSlider" Minimum="-180" Maximum="180" Value="0" ValueChanged="OnRotationChanged" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=RotationSlider, Path=Value, StringFormat={}{0:F0}°}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="↺ 0°" Style="{StaticResource ChipButtonStyle}" Margin="6,0,0,0" Click="OnResetRotationClicked" ToolTip="Reset rotation to 0°" />
                                </Grid>

                                <!-- Flip Buttons -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="FlipHButton" Grid.Column="0" Content="Flip ↔" Style="{StaticResource ChipButtonStyle}" Margin="0,0,4,0" Click="OnFlipHToggled" />
                                    <Button x:Name="FlipVButton" Grid.Column="1" Content="Flip ↕" Style="{StaticResource ChipButtonStyle}" Margin="4,0,0,0" Click="OnFlipVToggled" />
                                </Grid>

                                <TextBlock Text="Charm Opacity (10% - 100%)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="CharmOpacitySlider" Minimum="0.1" Maximum="1.0" Value="1.0" ValueChanged="OnCharmOpacityChanged" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=CharmOpacitySlider, Path=Value, StringFormat={}{0:P0}}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. ROPE CUSTOMIZATION CARD -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="ROPE &amp; CORD" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />

                                <TextBlock Text="Rope Color Swatches" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <WrapPanel Margin="0,0,0,8">
                                    <Border Width="22" Height="22" CornerRadius="11" Background="#F59E0B" BorderBrush="#2D2D38" BorderThickness="1" Margin="0,0,6,4" Cursor="Hand" MouseDown="OnRopeColorSwatchClicked" Tag="#F59E0B" ToolTip="Gold" />
                                    <Border Width="22" Height="22" CornerRadius="11" Background="#EF4444" BorderBrush="#2D2D38" BorderThickness="1" Margin="0,0,6,4" Cursor="Hand" MouseDown="OnRopeColorSwatchClicked" Tag="#EF4444" ToolTip="Crimson" />
                                    <Border Width="22" Height="22" CornerRadius="11" Background="#8B5CF6" BorderBrush="#2D2D38" BorderThickness="1" Margin="0,0,6,4" Cursor="Hand" MouseDown="OnRopeColorSwatchClicked" Tag="#8B5CF6" ToolTip="Violet" />
                                    <Border Width="22" Height="22" CornerRadius="11" Background="#06B6D4" BorderBrush="#2D2D38" BorderThickness="1" Margin="0,0,6,4" Cursor="Hand" MouseDown="OnRopeColorSwatchClicked" Tag="#06B6D4" ToolTip="Cyan" />
                                    <Border Width="22" Height="22" CornerRadius="11" Background="#10B981" BorderBrush="#2D2D38" BorderThickness="1" Margin="0,0,6,4" Cursor="Hand" MouseDown="OnRopeColorSwatchClicked" Tag="#10B981" ToolTip="Emerald" />
                                    <Border Width="22" Height="22" CornerRadius="11" Background="#27272A" BorderBrush="#40404C" BorderThickness="1" Margin="0,0,6,4" Cursor="Hand" MouseDown="OnRopeColorSwatchClicked" Tag="#27272A" ToolTip="Obsidian" />
                                    <Border Width="22" Height="22" CornerRadius="11" Background="#F4F4F5" BorderBrush="#2D2D38" BorderThickness="1" Margin="0,0,6,4" Cursor="Hand" MouseDown="OnRopeColorSwatchClicked" Tag="#F4F4F5" ToolTip="Silver White" />
                                </WrapPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="RopeColorTextBox" Text="(Default cord tint)" FontSize="11" TextChanged="OnRopeColorTextChanged" Margin="0,0,6,0" />
                                    <Button Grid.Column="1" Content="Clear" Style="{StaticResource ChipButtonStyle}" Click="OnClearRopeColorClicked" ToolTip="Reset to charm's natural cord" />
                                </Grid>

                                <TextBlock Text="Thickness (0.5x - 3.0x)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="RopeThicknessSlider" Minimum="0.5" Maximum="3.0" Value="1.0" ValueChanged="OnRopeThicknessChanged" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=RopeThicknessSlider, Path=Value, StringFormat={}{0:F2}x}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="Length (0.5x - 2.0x)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="RopeLengthSlider" Minimum="0.5" Maximum="2.0" Value="1.0" ValueChanged="OnRopeLengthChanged" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=RopeLengthSlider, Path=Value, StringFormat={}{0:F2}x}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="Rope Opacity (10% - 100%)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="RopeOpacitySlider" Minimum="0.1" Maximum="1.0" Value="1.0" ValueChanged="OnRopeOpacityChanged" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=RopeOpacitySlider, Path=Value, StringFormat={}{0:P0}}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. APPEARANCE & EFFECTS CARD -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="APPEARANCE &amp; EFFECTS" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />

                                <TextBlock Text="Shadow Intensity (0% - 100%)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="ShadowSlider" Minimum="0.0" Maximum="1.0" Value="0.35" ValueChanged="OnShadowChanged" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=ShadowSlider, Path=Value, StringFormat={}{0:P0}}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="Glow Intensity (0% - 100%)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="GlowSlider" Minimum="0.0" Maximum="1.0" Value="0.20" ValueChanged="OnGlowChanged" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=GlowSlider, Path=Value, StringFormat={}{0:P0}}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="Shine Glint (0% - 100%)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="ShineSlider" Minimum="0.0" Maximum="1.0" Value="0.50" ValueChanged="OnShineChanged" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=ShineSlider, Path=Value, StringFormat={}{0:P0}}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="Outline Stroke (0px - 6px)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="OutlineThicknessSlider" Minimum="0.0" Maximum="6.0" Value="0.0" ValueChanged="OnOutlineThicknessChanged" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=OutlineThicknessSlider, Path=Value, StringFormat={}{0:F1}px}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4. PHYSICS & SOUND (PRESERVED) -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="PHYSICS &amp; SOUND" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />

                                <TextBlock Text="Simulated Mass (2.0 - 4.5)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="MassSlider" Minimum="2.0" Maximum="4.5" Value="3.0" ValueChanged="OnMassChanged" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=MassSlider, Path=Value, StringFormat={}{0:F2}}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="Knot Inset (0.3 - 1.0)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="KnotInsetSlider" Minimum="0.3" Maximum="1.0" Value="0.8" ValueChanged="OnKnotInsetChanged" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=KnotInsetSlider, Path=Value, StringFormat={}{0:F2}}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="Sound Effect" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="SoundComboBox" Margin="0,0,8,0">
                                        <ComboBoxItem Content="Wood (Default)" Tag="Wood" IsSelected="True" />
                                        <ComboBoxItem Content="Bell" Tag="Bell" />
                                        <ComboBoxItem Content="Glass" Tag="Glass" />
                                        <ComboBoxItem Content="Metal" Tag="Metal" />
                                        <ComboBoxItem Content="Soft" Tag="Soft" />
                                    </ComboBox>
                                    <Button Grid.Column="1" Content="🔊 Test" Click="OnTestSoundClicked" Padding="8,4" />
                                </Grid>

                                <TextBlock Text="Custom Sound (.wav file)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CustomSoundPathTextBox" IsReadOnly="True" Text="(Built-in harmonic tone)" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Browse…" Click="OnBrowseCustomSoundClicked" Margin="0,0,4,0" Padding="8,4" />
                                    <Button x:Name="ClearCustomSoundButton" Grid.Column="2" Content="✕" Click="OnClearCustomSoundClicked" Visibility="Collapsed" Padding="8,4" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Hidden elements for code-behind backward compatibility -->
                        <TextBox x:Name="CharmNameTextBox" Visibility="Collapsed" Text="My Charm" />
                        <Border x:Name="DropZoneBorder" Visibility="Collapsed" />
                        <Grid x:Name="WorkspaceGrid" Visibility="Collapsed" />
                        <Image x:Name="CharmVisualPreview" Visibility="Collapsed" />
                        <Border x:Name="PalettePrimary" Visibility="Collapsed" />
                        <Border x:Name="PaletteSecondary" Visibility="Collapsed" />
                        <Border x:Name="PaletteDeep" Visibility="Collapsed" />
                        <Border x:Name="PaletteLight" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- SUCCESS OVERLAY TOAST -->
        <Grid x:Name="SuccessOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="12" Padding="28" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="✨" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="Customization Saved!" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock x:Name="SuccessMessageText" Text="Your customized charm is now active on your desktop." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Keep Editing" Click="OnKeepEditingClicked" Margin="0,0,10,0" />
                        <Button Content="Done" Style="{StaticResource PrimaryButtonStyle}" Click="OnDoneClicked" Padding="24,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <TextBlock x:Name="StatusInfoText" Text="Ready. Customize rope, size, colors, or drag charm in canvas." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusMetaText" Text="Single Source of Truth: Active" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
