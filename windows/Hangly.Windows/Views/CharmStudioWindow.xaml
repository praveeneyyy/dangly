<Window x:Class="Hangly.Windows.Views.CharmStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dangly — Charm Studio"
        Width="920" Height="620"
        MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#141416"
        Foreground="#F4F4F5"
        FontFamily="Segoe UI, -apple-system, system-ui">
    
    <Window.Resources>
        <!-- Modern Dark Theme Styles -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1E1E22" />
        <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#2E2E34" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F5" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#71717A" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A30" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#373740" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#18181B" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CaretBrush" Value="#60A5FA" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#18181B" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#3B82F6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✦ " FontSize="16" Foreground="#60A5FA" VerticalAlignment="Center" />
                    <TextBlock Text="AI Charm Studio" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="— Create custom hanging ornaments" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenImageButton" Content="Open Image…" Click="OnOpenImageClicked" Margin="0,0,10,0" />
                    <CheckBox x:Name="UseOnRopeCheckBox" Content="Use on rope" IsChecked="True" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button x:Name="SaveToLibraryButton" Content="Save to Library" Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveClicked" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <!-- Empty State Drop Zone -->
            <Border x:Name="DropZoneBorder" 
                    Background="#18181C"
                    BorderBrush="#33333D" 
                    BorderThickness="2" 
                    CornerRadius="12"
                    Margin="36"
                    AllowDrop="True"
                    DragEnter="OnDropZoneDragEnter"
                    DragLeave="OnDropZoneDragLeave"
                    Drop="OnDropZoneDrop">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#24242C" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="🖼" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Drop an image to make a charm" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="PNG, JPEG, WebP, or BMP. The subject will be isolated and balanced." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,20" />
                    <Button Content="Choose File From Disk…" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Click="OnOpenImageClicked" Padding="20,10" />
                </StackPanel>
            </Border>

            <!-- Active Workspace (Visible when an image is loaded) -->
            <Grid x:Name="WorkspaceGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Source & Cutout -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,1,0" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="BACKGROUND REMOVAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                            <TextBlock Text="Strategy" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="StrategyComboBox" SelectionChanged="OnStrategyChanged" Margin="0,0,0,14">
                                <ComboBoxItem Content="Automatic (Smart)" IsSelected="True" />
                                <ComboBoxItem Content="Corner Flood Fill" />
                                <ComboBoxItem Content="Keep Original (None)" />
                            </ComboBox>

                            <TextBlock Text="Tolerance (0 - 100)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="ToleranceSlider" Minimum="0" Maximum="100" Value="36" ValueChanged="OnToleranceChanged" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=ToleranceSlider, Path=Value, StringFormat={}{0:F0}}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Button Content="Re-process Image" Click="OnReprocessClicked" Margin="0,0,0,20" />

                            <Separator Background="{StaticResource SurfaceBorderBrush}" Margin="0,0,0,16" />

                            <TextBlock Text="SOURCE THUMBNAIL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                            <Border BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Background="#121214" Height="140" Padding="6">
                                <Image x:Name="SourceImagePreview" Stretch="Uniform" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Middle Column: Interactive Live Charm Preview -->
                <Grid Grid.Column="1" Background="#111113">
                    <Border Background="#16161A" CornerRadius="12" Margin="24" BorderBrush="#25252B" BorderThickness="1">
                        <Grid>
                            <!-- Visual simulated rope & charm render preview -->
                            <Image x:Name="CharmVisualPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="300" Margin="20" />
                            <TextBlock Text="Live Charm Canvas" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right Column: Charm & Physics Properties -->
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1,0,0,0" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="CHARM PROPERTIES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                            <TextBlock Text="Charm Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="CharmNameTextBox" Text="My Charm" Margin="0,0,0,14" />

                            <TextBlock Text="Sound Effect" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SoundComboBox" Margin="0,0,8,0">
                                    <ComboBoxItem Content="Wood (Default)" Tag="Wood" IsSelected="True" />
                                    <ComboBoxItem Content="Bell" Tag="Bell" />
                                    <ComboBoxItem Content="Glass" Tag="Glass" />
                                    <ComboBoxItem Content="Metal" Tag="Metal" />
                                    <ComboBoxItem Content="Soft" Tag="Soft" />
                                </ComboBox>
                                <Button Grid.Column="1" Content="🔊 Test" Click="OnTestSoundClicked" Padding="8,6" />
                            </Grid>

                            <TextBlock Text="Custom Sound (.wav file, optional)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CustomSoundPathTextBox" IsReadOnly="True" Text="(Built-in harmonic tone)" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Browse…" Click="OnBrowseCustomSoundClicked" Margin="0,0,4,0" Padding="8,6" />
                                <Button x:Name="ClearCustomSoundButton" Grid.Column="2" Content="✕" ToolTip="Clear custom sound" Click="OnClearCustomSoundClicked" Visibility="Collapsed" Padding="8,6" />
                            </Grid>

                            <Separator Background="{StaticResource SurfaceBorderBrush}" Margin="0,0,0,16" />

                            <TextBlock Text="PHYSICS METRICS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                            <TextBlock Text="Simulated Mass (2.0 - 4.5)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="MassSlider" Minimum="2.0" Maximum="4.5" Value="3.0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=MassSlider, Path=Value, StringFormat={}{0:F2}}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="Knot Inset (0.3 - 1.0)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="KnotInsetSlider" Minimum="0.3" Maximum="1.0" Value="0.8" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=KnotInsetSlider, Path=Value, StringFormat={}{0:F2}}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Separator Background="{StaticResource SurfaceBorderBrush}" Margin="0,0,0,16" />

                            <TextBlock Text="EXTRACTED PALETTE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                            <UniformGrid Columns="4" Height="36" Margin="0,0,0,14">
                                <Border x:Name="PalettePrimary" CornerRadius="4,0,0,4" Background="#3B82F6" ToolTip="Primary" />
                                <Border x:Name="PaletteSecondary" Background="#60A5FA" ToolTip="Secondary" />
                                <Border x:Name="PaletteDeep" Background="#1E3A8A" ToolTip="Deep" />
                                <Border x:Name="PaletteLight" CornerRadius="0,4,4,0" Background="#93C5FD" ToolTip="Light" />
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Success Overlay Toast -->
            <Grid x:Name="SuccessOverlay" Background="#99000000" Visibility="Collapsed">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="12" Padding="28" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="✨" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="Saved to Library!" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock x:Name="SuccessMessageText" Text="Your charm is now ready and hanging on the rope." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Make Another" Click="OnMakeAnotherClicked" Margin="0,0,10,0" />
                            <Button Content="Done" Style="{StaticResource PrimaryButtonStyle}" Click="OnDoneClicked" Padding="24,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <TextBlock x:Name="StatusInfoText" Text="Ready. Drop an image or click Open." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusMetaText" Text="" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
