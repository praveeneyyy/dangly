<Window x:Class="Hangly.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dangly Settings"
        Width="780" Height="560"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#141416"
        Foreground="#F4F4F5"
        FontFamily="Segoe UI, -apple-system, system-ui">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1E1E22" />
        <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#2E2E34" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F5" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#71717A" />

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" 
                                Background="Transparent" 
                                BorderBrush="Transparent" 
                                BorderThickness="0,0,0,2" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A30" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#373740" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#3B82F6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Tabs -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="20,12,20,0">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Dangly" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="— Physical Desktop Charm" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,2,0,0" />
                    </StackPanel>
                    <TextBlock Text="Windows Edition" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <TabControl x:Name="SettingsTabControl" SelectionChanged="OnTabChanged">
                    <TabItem Header="General" />
                    <TabItem Header="Placement &amp; Size" />
                    <TabItem Header="Charm Library" />
                    <TabItem Header="About" />
                </TabControl>
            </StackPanel>
        </Border>

        <!-- Tab Pages Content -->
        <Grid Grid.Row="1" Margin="24,18">
            <!-- TAB 0: General Settings -->
            <ScrollViewer x:Name="GeneralTabContent" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                    <!-- Section: Overlay -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="OVERLAY VISIBILITY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />
                            <CheckBox x:Name="ShowOverlayCheckBox" Content="Show hanging charm overlay on desktop" Click="OnOverlaySettingChanged" Margin="0,0,0,8" />
                            <TextBlock Text="The charm floats transparently above all applications." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Section: Audio -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="SOUND EFFECTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />
                            <CheckBox x:Name="PlaySoundCheckBox" Content="Play sound effects on swing, tap, and charm switch" Click="OnSoundSettingChanged" Margin="0,0,0,12" />

                            <TextBlock Text="Volume" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SoundVolumeSlider" Minimum="0.0" Maximum="1.0" Value="0.14" ValueChanged="OnSoundVolumeChanged" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=SoundVolumeSlider, Path=Value, StringFormat={}{0:P0}}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button Grid.Column="2" Content="🔊 Test" Click="OnTestVolumeClicked" Padding="10,5" />
                            </Grid>
                            <TextBlock Text="Additive synthetic physics chimes: bells ring, wood knocks, and crystal clinks." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Section: Startup & Interaction -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="SYSTEM &amp; INTERACTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />
                            <CheckBox x:Name="LaunchAtStartupCheckBox" Content="Launch Dangly when Windows starts" Click="OnLaunchStartupChanged" Margin="0,0,0,12" />
                            <CheckBox x:Name="ClickThroughCheckBox" Content="Click-through everywhere except the charm body" Click="OnClickThroughChanged" Margin="0,0,0,6" />
                            <TextBlock Text="When enabled, clicks outside the charm grab zone pass directly to the apps underneath." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Reset Button -->
                    <Button Content="Reset All Settings to Defaults" Click="OnResetAllSettingsClicked" HorizontalAlignment="Left" Margin="0,0,0,24" />
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 1: Placement & Size Settings -->
            <ScrollViewer x:Name="PlacementTabContent" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                    <!-- Size & Opacity -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="APPEARANCE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                            <TextBlock Text="Rope &amp; Charm Scale" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="2.0" Value="1.0" ValueChanged="OnScaleChanged" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=ScaleSlider, Path=Value, StringFormat={}{0:F2}x}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="Opacity" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1.0" Value="1.0" ValueChanged="OnOpacityChanged" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Position & Offsets -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="DESKTOP POSITION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                            <TextBlock Text="Anchor" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="AnchorComboBox" SelectionChanged="OnAnchorChanged" Margin="0,0,0,14">
                                <ComboBoxItem Content="Top-Right (Default)" IsSelected="True" />
                                <ComboBoxItem Content="Top-Center" />
                                <ComboBoxItem Content="Top-Left" />
                            </ComboBox>

                            <TextBlock Text="Horizontal Offset" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="HorizontalOffsetSlider" Minimum="-300" Maximum="300" Value="12" ValueChanged="OnOffsetsChanged" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=HorizontalOffsetSlider, Path=Value, StringFormat={}{0:F0}px}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="Vertical Offset" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="VerticalOffsetSlider" Minimum="-50" Maximum="200" Value="-12" ValueChanged="OnOffsetsChanged" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=VerticalOffsetSlider, Path=Value, StringFormat={}{0:F0}px}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Content="Reset Placement Settings" Click="OnResetPlacementClicked" HorizontalAlignment="Left" Margin="0,0,0,24" />
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 2: Charm Library -->
            <Grid x:Name="LibraryTabContent" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Choose a charm to hang on your rope" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Content="✦ Open Charm Studio…" Style="{StaticResource PrimaryButtonStyle}" Click="OnOpenStudioClicked" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Built-in Collection Charms -->
                        <TextBlock Text="DANGLY COLLECTION (11)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                        <WrapPanel x:Name="CollectionCharmsPanel" Margin="0,0,0,18" />

                        <!-- Classic Charms -->
                        <TextBlock Text="CLASSICS (5)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                        <WrapPanel x:Name="ClassicCharmsPanel" Margin="0,0,0,18" />

                        <!-- Custom Imported Charms -->
                        <TextBlock Text="CUSTOM CHARMS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                        <WrapPanel x:Name="CustomCharmsPanel" Margin="0,0,0,18" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- TAB 3: About -->
            <Grid x:Name="AboutTabContent" Visibility="Collapsed">
                <StackPanel MaxWidth="520" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,20,0,0">
                    <Border Width="64" Height="64" CornerRadius="16" Background="#24242C" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <TextBlock Text="🧶" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Dangly for Windows" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="Version 1.0.0 (Native .NET 10 &amp; WPF)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />
                    
                    <TextBlock Text="Dangly is a physics-simulated hanging charm ornament. The physics engine simulates 20 Verlet constraint segments, dual-pass bead projection, and harmonic audio synthesis at 240 Hz fixed timestep with 100% mathematical fidelity to the native macOS implementation." 
                                FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="20" />
                    
                    <TextBlock Text="• Zero telemetry, 100% private, runs entirely on-device." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="• Settings stored in %LOCALAPPDATA%\Dangly\settings.json" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="• Supports custom image imports via Charm Studio." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,24" />

                    <Button Content="Reset Rope Position" Click="OnResetRopeClicked" HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
