<Window x:Class="Hangly.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dangly — Settings"
        Width="820" Height="620"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F11"
        Foreground="#FAFAFA"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, system-ui">

    <Window.Resources>
        <!-- Modern Minimal Palette -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F0F11" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#18181B" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#202024" />
        <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#27272A" />
        <SolidColorBrush x:Key="SurfaceBorderLightBrush" Color="#3F3F46" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FAFAFA" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#71717A" />

        <!-- Segmented Tab Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" 
                                Background="Transparent" 
                                BorderBrush="Transparent" 
                                BorderThickness="0,0,0,2" 
                                Margin="0,0,6,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#222226" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2C2C32" />
                                <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A1A1E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Call-to-Action Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="#60A5FA" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                    <Setter Property="BorderBrush" Value="#93C5FD" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Subtle Card Container -->
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Modern Checkbox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Minimal Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#222226" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header & Segmented Tabs -->
        <Border Grid.Row="0" Background="#141417" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="24,14,24,0">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/dangly-icon-128.png" Width="26" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Dangly" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Settings" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="8,2,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Version & Status Badge -->
                    <Border HorizontalAlignment="Right" Background="#1E1E24" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3">
                        <TextBlock Text="v1.0 • Windows" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </Grid>

                <!-- Navigation Tabs -->
                <TabControl x:Name="SettingsTabControl" SelectionChanged="OnTabChanged">
                    <TabItem Header="General" />
                    <TabItem Header="Placement &amp; Size" />
                    <TabItem Header="Charm Library" />
                    <TabItem Header="About" />
                </TabControl>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1" Margin="28,20">
            <!-- TAB 0: General Settings -->
            <ScrollViewer x:Name="GeneralTabContent" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                    <!-- Overlay Visibility Card -->
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="OVERLAY VISIBILITY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />
                            <CheckBox x:Name="ShowOverlayCheckBox" Content="Show hanging charm overlay on desktop" Click="OnOverlaySettingChanged" FontWeight="Medium" />
                            <TextBlock Text="The charm swings transparently above desktop windows and responds to physics interaction." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="20,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Sound Card -->
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="PHYSICAL AUDIO CHIMES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />
                            <CheckBox x:Name="PlaySoundCheckBox" Content="Play synthetic acoustic chimes on motion, swing, and impact" Click="OnSoundSettingChanged" FontWeight="Medium" Margin="0,0,0,12" />

                            <TextBlock Text="Volume" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SoundVolumeSlider" Minimum="0.0" Maximum="1.0" Value="0.14" ValueChanged="OnSoundVolumeChanged" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=SoundVolumeSlider, Path=Value, StringFormat={}{0:P0}}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" />
                                <Button Grid.Column="2" Content="🔊 Test Chime" Click="OnTestVolumeClicked" Padding="12,5" />
                            </Grid>
                            <TextBlock Text="On-device additive harmonic synthesizer: bell rings, wood knocks, and crystal pings." FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- System & Startup Card -->
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="STARTUP &amp; INTERACTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />
                            <CheckBox x:Name="LaunchAtStartupCheckBox" Content="Launch Dangly automatically when Windows starts" Click="OnLaunchStartupChanged" FontWeight="Medium" Margin="0,0,0,10" />
                            <CheckBox x:Name="ClickThroughCheckBox" Content="Click-through transparent backdrop" Click="OnClickThroughChanged" FontWeight="Medium" />
                            <TextBlock Text="When enabled, clicking anywhere outside the charm body passes directly to apps underneath." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="20,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Defaults Action -->
                    <Button Content="Reset All Settings to Defaults" Click="OnResetAllSettingsClicked" HorizontalAlignment="Left" Margin="0,4,0,24" />
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 1: Placement & Size Settings -->
            <ScrollViewer x:Name="PlacementTabContent" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                    <!-- Scale & Opacity Card -->
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="SCALE &amp; OPACITY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                            <TextBlock Text="Rope &amp; Charm Scale" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="2.0" Value="1.0" ValueChanged="OnScaleChanged" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=ScaleSlider, Path=Value, StringFormat={}{0:F2}x}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                            </Grid>

                            <TextBlock Text="Charm Opacity" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1.0" Value="1.0" ValueChanged="OnOpacityChanged" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Position Card -->
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="DESKTOP ANCHOR &amp; OFFSETS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                            <TextBlock Text="Anchor Point" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <ComboBox x:Name="AnchorComboBox" SelectionChanged="OnAnchorChanged" Margin="0,0,0,14" Width="240" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Top-Right (Default)" IsSelected="True" />
                                <ComboBoxItem Content="Top-Center" />
                                <ComboBoxItem Content="Top-Left" />
                            </ComboBox>

                            <TextBlock Text="Horizontal Offset" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="HorizontalOffsetSlider" Minimum="-300" Maximum="300" Value="12" ValueChanged="OnOffsetsChanged" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=HorizontalOffsetSlider, Path=Value, StringFormat={}{0:F0}px}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                            </Grid>

                            <TextBlock Text="Vertical Offset" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="VerticalOffsetSlider" Minimum="-50" Maximum="200" Value="-12" ValueChanged="OnOffsetsChanged" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=VerticalOffsetSlider, Path=Value, StringFormat={}{0:F0}px}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Content="Reset Placement Settings" Click="OnResetPlacementClicked" HorizontalAlignment="Left" Margin="0,4,0,24" />
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 2: Charm Library -->
            <Grid x:Name="LibraryTabContent" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Choose a charm to hang on your rope" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Content="✦ Open Charm Studio…" Style="{StaticResource PrimaryButtonStyle}" Click="OnOpenStudioClicked" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Built-in Collection Charms -->
                        <TextBlock Text="DANGLY COLLECTION (11)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />
                        <WrapPanel x:Name="CollectionCharmsPanel" Margin="0,0,0,18" />

                        <!-- Classic Charms -->
                        <TextBlock Text="GEOMETRIC CLASSICS (5)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />
                        <WrapPanel x:Name="ClassicCharmsPanel" Margin="0,0,0,18" />

                        <!-- Custom Imported Charms -->
                        <TextBlock Text="CUSTOM CHARMS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />
                        <WrapPanel x:Name="CustomCharmsPanel" Margin="0,0,0,18" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- TAB 3: About -->
            <Grid x:Name="AboutTabContent" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <!-- Branding Banner Card -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <Image Source="/Assets/Branding/Dangly-Banner.png" MaxHeight="160" Stretch="Uniform" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,10" />
                                <TextBlock Text="Things shouldn't just sit there." FontSize="13" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            </StackPanel>
                        </Border>

                        <!-- Overview Card -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="ENGINE SPECIFICATIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />
                                <TextBlock Text="Dangly puts a responsive, tactile charm ornament on your desktop that obeys real physical laws. The simulation runs a 20-segment Verlet integrator solved at fixed 240 Hz with Gauss-Seidel distance relaxation, dynamic stretch recoil, and independent bead projection." 
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12" />
                                <TextBlock Text="• Fixed 240 Hz Verlet timestep decoupled from display refresh rate." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="• Zero telemetry, 100% private, on-device compute." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="• Low power: suspends simulation when still (0% CPU / GPU)." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="• Settings persisted in %LOCALAPPDATA%\Dangly\settings.json" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                            </StackPanel>
                        </Border>

                        <Button Content="Reset Rope Position" Click="OnResetRopeClicked" HorizontalAlignment="Left" Margin="0,4,0,24" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
