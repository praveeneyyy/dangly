# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly ensure LF on shell scripts, source code, and configurations
*.sh text eol=lf
*.swift text eol=lf
*.cs text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.plist text eol=lf
*.entitlements text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.heic binary
*.ico binary
*.icns binary
*.dmg binary
*.dll binary
*.exe binary
